{
  "name": "@seydx/wyze-api",
  "version": "0.0.1",
  "description": "An unoficial API wrapper for Wyze products.",
  "homepage": "https://github.com/seydx/wyze-api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "prettier --write 'src/' --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "update": "updates --update ./",
    "install-updates": "npm i --save",
    "prepublishOnly": "npm i --package-lock-only && npm run lint:fix && npm run format && npm run build"
  },
  "keywords": [
    "wyze",
    "wyze-api",
    "api",
    "node",
    "sensors",
    "wyzecam",
    "wyze-node",
    "wyze bulbs",
    "wyze sense"
  ],
  "author": "seydx",
  "license": "MIT",
  "dependencies": {
    "axios": "1.7.4",
    "querystring": "0.2.1",
    "uuid-by-string": "4.0.0",
    "aws-sdk": "2.1678.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.53.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "24.10.4",
    "@types/unzipper": "^0.10.11",
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "updates": "^17.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seydx/wyze-api.git"
  },
  "bugs": {
    "url": "https://github.com/seydx/wyze-api/issues"
  }
}
